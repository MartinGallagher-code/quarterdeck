include LICENSE
include README.md
include CHANGELOG.md
include REUSE.toml
include qd
recursive-include LICENSES *
recursive-include quarterdeck/web *.html *.js *.css
# qd demo's fleet: its hosts, plan, answers and limits, as text
recursive-include quarterdeck/demo *
# the walkthrough, which tests/test_demo.sh runs
include docs/getting-started.md
# Ship the test suite in the sdist so it can be run against exactly what was
# unpacked. It needs only bash and python3.
recursive-include tests *
